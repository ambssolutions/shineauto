{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/your-mix",
      "destination": "/designs/06-your-mix/",
      "permanent": false
    },
    {
      "source": "/roller-door",
      "destination": "/designs/01-roller-door/",
      "permanent": false
    },
    {
      "source": "/plate",
      "destination": "/designs/02-number-plate/",
      "permanent": false
    },
    {
      "source": "/job-card",
      "destination": "/designs/03-job-card/",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/designs/04-dashboard/",
      "permanent": false
    },
    {
      "source": "/pressed-metal",
      "destination": "/designs/05-pressed-metal/",
      "permanent": false
    }
  ]
}